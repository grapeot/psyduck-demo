{
  "name": "psyduck-threejs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1", "render": "node render_anime.mjs final",
    "prestart": "npm run prepare:worker",
    "prebuild": "npm run prepare:assets",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:worker": "node scripts/prepare-worker.mjs",
    "generate:rig": "node scripts/generate-rig.mjs",
    "build": "vite build --base=/psyduck-demo/",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:dev": "node tests/dev-smoke.mjs",
    "test:clean-build": "node tests/clean-build.mjs"
  },
  "dependencies": { "@mediapipe/tasks-vision": "0.10.22-rc.20250304", "three": "0.180.0", "vite": "7.3.6", "playwright": "1.55.1" }
}
